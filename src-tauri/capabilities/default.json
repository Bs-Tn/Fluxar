{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "opener:default",
        {
            "identifier": "opener:allow-open-path",
            "allow": [{ "path": "**", "app": true }]
        },
        "dialog:default",
        "dialog:allow-save",
        {
            "identifier": "fs:scope",
            "allow": [{ "path": "**", "app": true }]
        },
        "fs:allow-read-dir",
        "fs:allow-read",
        "fs:allow-read-text-file",
        "fs:allow-write-text-file"
    ]
}
